# Free transcription key from https://console.groq.com/keys (no card needed).
# Leave blank to transcribe on your own computer instead (needs Python and: pip install faster-whisper).
GROQ_API_KEY=
# Free B-roll (stock footage on the key words). One key is enough; Pexels is tried first.
# Pexels: https://www.pexels.com/api/   Pixabay: https://pixabay.com/api/docs/ (key shown after sign-in)
PEXELS_API_KEY=
PIXABAY_API_KEY=
