{
  "name": "fable-engine",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Fable engine: local HyperFrames rendering, transcript-driven cuts, captions, and motion graphics for the Fable video editor.",
  "scripts": {
    "validate-beats": "node scripts/validate-beat-sync.mjs",
    "preflight": "node scripts/preflight.mjs",
    "new-video": "node scripts/new-video.mjs",
    "demo": "node scripts/new-video.mjs demo",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-engine.mjs",
    "catalog": "node scripts/style-library/build-registry.mjs",
    "test:media": "node scripts/smoke-media.mjs",
    "validate:short-form": "node .agents/skills/short-form-edit/scripts/validate-plan.mjs",
    "validate:footage": "node .agents/skills/short-form-edit/scripts/validate-footage.mjs",
    "preflight:all": "node scripts/preflight-all.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "hyperframes": "0.7.109",
    "gsap": "3.14.2",
    "playwright": "^1.59.1"
  }
}
